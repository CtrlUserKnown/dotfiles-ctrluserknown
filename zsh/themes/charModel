# Date: 2026-06-28

# git status is computed in precmd (once per prompt) to avoid blocking on every keypress
_GIT_INFO=""

function _update_git_info() {
    local branch dirty_flag ahead_behind
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
    if [[ -n $branch ]]; then
        if ! git diff --quiet 2>/dev/null || ! git diff --cached --quiet 2>/dev/null; then
            # * indicates a dirty working tree
            dirty_flag="*"
        else
            dirty_flag=""
        fi

        # ahead/behind counts vs upstream, e.g. ↑2 ↓1 — empty if no upstream is set
        ahead_behind=""
        local counts
        counts=$(git rev-list --left-right --count '@{upstream}...HEAD' 2>/dev/null)
        if [[ -n $counts ]]; then
            local behind=${counts%%$'\t'*}
            local ahead=${counts##*$'\t'}
            [[ $behind -gt 0 ]] && ahead_behind+=" ↓${behind}"
            [[ $ahead -gt 0 ]] && ahead_behind+=" ↑${ahead}"
        fi

        _GIT_INFO="%F{5} ($branch$dirty_flag)%f%F{3}$ahead_behind%f"
    else
        _GIT_INFO=""
    fi
}

autoload -Uz add-zsh-hook
add-zsh-hook precmd _update_git_info

setopt prompt_subst

# SSH takes priority — the ∧ indicator already signals remote, so drop the machine symbol.
# Outside SSH: ⟚ on herdr, ⋧ everywhere else.
if [[ -n "${SSH_CLIENT:-}" || -n "${SSH_TTY:-}" ]]; then
    _MACHINE_SYMBOL=""
    _SSH_INDICATOR="%F{cyan}∧%f "
elif [[ "$(hostname -s)" == "herdr" ]]; then
    _MACHINE_SYMBOL="⟚ "
    _SSH_INDICATOR=""
else
    _MACHINE_SYMBOL="⋧ "
    _SSH_INDICATOR=""
fi

PROMPT='${_MACHINE_SYMBOL}${_SSH_INDICATOR}[%F{5}%n%f: %~]${_GIT_INFO} » '

# emacs line-editing mode (ctrl+a/e for line start/end)
bindkey -e
# escape in the completion menu cancels without selecting
bindkey -M menuselect '^[' undo
# / selects the entry & drills into the next path component
bindkey -M menuselect '/' accept-and-infer-next-history
